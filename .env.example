# Copy to .env and adjust. .env is never committed.

# REQUIRED. The SEC requires a User-Agent in the form "Name contact@domain".
# Use your own name/project and a real contact e-mail.
SEC_USER_AGENT="RadarSEC contact@example.com"

# AI summaries (Claude Agent SDK) need NO variable here: just be logged in to
# Claude Code on this machine (run `claude` and use /login); summaries use your
# subscription. If the AI fails, the summary falls back to a template.
#
# For a server or a machine without a login, create a token with
# `claude setup-token` and uncomment the line below.
# CLAUDE_CODE_OAUTH_TOKEN=
#
# ANTHROPIC_API_KEY is not used: the radar removes it from the environment
# before calling the AI, so a call is never billed through the API.

# Optional: Telegram alerts (enabled only when both are set).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: comma-separated alert channels (console, macos, telegram).
# Default: console (+ telegram when the variables above are set).
# RADAR_ALERTS=console,macos

# Optional: language for AI summaries, alerts and CLI output (en or pt-BR).
# Overrides `lang` in radar.toml. Default: en.
# RADAR_LANG=en

# Optional, paid: Tiingo (https://api.tiingo.com). With a key the dashboard quotes come from
# Tiingo IEX in real time (Yahoo stays as the fallback), the forward-test daily closes from
# Tiingo end-of-day prices, and the news source reads Tiingo News if your plan includes it
# (a 403 turns that feed off for the session). The key is sent only in the Authorization
# header and never logged. See [prices] in radar.toml for the limits.
# TIINGO_API_KEY=

# Optional: where to keep the database and cache (default: ./data) and the config file.
# RADAR_DATA_DIR=data
# RADAR_CONFIG=radar.toml
